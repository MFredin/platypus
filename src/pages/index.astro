---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import SectionTitle from '../components/SectionTitle.astro';
import NewsCard from '../components/NewsCard.astro';
import { sitePath } from '../utils/paths';
---
<BaseLayout title="A new dawn begins" description="Daybreak is a united guild in Foundation: Galactic Frontier, built for explorers, strategists, and pioneers.">
  <section class="hero">
    <div class="stars"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
    <div class="planet"></div><div class="sun-glow"></div>
    <div class="hero-content">
      <div class="hero-sigil"><Logo /></div>
      <p class="eyebrow">Foundation: Galactic Frontier</p>
      <h1>DAYBREAK</h1>
      <p class="hero-tagline">Together at dawn. <span>Limitless beyond.</span></p>
      <p class="hero-copy">A united guild for those who see the frontier not as an edge, but as an invitation.</p>
      <div class="hero-actions"><a class="button primary" href={sitePath('/join/')}>Join the expedition</a><a class="button ghost" href={sitePath('/about/')}>Discover Daybreak</a></div>
    </div>
    <div class="scroll-cue"><span>Scroll to explore</span><i></i></div>
  </section>

  <section class="section intro-section">
    <div class="intro-statement">
      <span class="chapter">01 / Our purpose</span>
      <h2>We rise together.</h2>
      <p>Daybreak is more than a name above a fleet. It is a promise: to build with purpose, explore without limits, and ensure no member faces the frontier alone.</p>
      <a class="text-link" href={sitePath('/about/')}>Our story <span>→</span></a>
    </div>
    <div class="pillars">
      <article><b>01</b><span class="line-icon">✦</span><h3>Unity</h3><p>One guild, many paths. We turn individual strengths into collective momentum.</p></article>
      <article><b>02</b><span class="line-icon">◈</span><h3>Discovery</h3><p>The unknown calls. We share knowledge and chart the frontier together.</p></article>
      <article><b>03</b><span class="line-icon">⌁</span><h3>Purpose</h3><p>Every mission matters. Every member has a place in what we build next.</p></article>
    </div>
  </section>

  <section class="section transmissions">
    <SectionTitle eyebrow="Guild transmissions" title="From the horizon" copy="The latest briefings, milestones, and calls to action from Daybreak command." />
    <div class="news-grid">
      <NewsCard featured category="Announcement" date="Aug 09, 2026" title="A new dawn begins" copy="The Daybreak network is online. Discover the vision behind our guild and the future we intend to build together." />
      <NewsCard category="Recruitment" date="Aug 07, 2026" title="Pioneers wanted" copy="Our signal is open to thoughtful, active players ready to make their mark on the frontier." />
      <NewsCard category="Field report" date="Aug 02, 2026" title="Preparing for launch" copy="Command shares our first priorities: a capable fleet, a strong economy, and a culture worth protecting." />
    </div>
    <a class="button ghost view-all" href={sitePath('/news/')}>View all transmissions</a>
  </section>

  <section class="recruit-cta">
    <div class="cta-orbit"></div>
    <span class="eyebrow">The signal is open</span><h2>Find your place<br />among the stars.</h2>
    <p>We are assembling the pioneers, builders, strategists, and explorers who will shape Daybreak's next chapter.</p>
    <a class="button primary" href={sitePath('/join/')}>Begin your application</a>
  </section>
</BaseLayout>

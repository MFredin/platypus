---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Join Daybreak"
  description="Join Daybreak and help shape our future in Foundation: Galactic Frontier."
>
  <section class="page-hero join-hero">
    <span class="eyebrow">Recruitment status / Open</span><h1>
      Your place is<br /><em>waiting.</em>
    </h1><p>
      There is a horizon only you can help us reach. Answer the signal and build
      something lasting.
    </p><a class="button primary" href="#process">View the process</a>
  </section>
  <section class="section fit-section">
    <span class="chapter">Who we're looking for</span><div class="fit-copy">
      <h2>Bring ambition.<br />Leave ego behind.</h2><p>
        Experience is valuable. Character is essential. Daybreak is looking for
        active players who enjoy learning, contributing, and winning as a team.
      </p>
    </div><ul class="check-list">
      <li><span>01</span>Active and communicative</li><li>
        <span>02</span>Team-first mindset
      </li><li><span>03</span>Respectful and dependable</li><li>
        <span>04</span>Ready to learn and contribute
      </li>
    </ul>
  </section>
  <section class="section process" id="process">
    <div class="section-title">
      <span class="eyebrow">Application protocol</span><h2>
        Three steps to dawn
      </h2>
    </div><div class="process-grid">
      <article>
        <b>01</b><h3>Enter the network</h3><p>
          Join our Discord server and introduce yourself to the community.
        </p>
      </article><article>
        <b>02</b><h3>Share your signal</h3><p>
          Tell us about your playstyle, goals, and what you seek in a guild.
        </p>
      </article><article>
        <b>03</b><h3>Meet the fleet</h3><p>
          Connect with leadership, ask questions, and begin your journey.
        </p>
      </article>
    </div><div class="apply-panel">
      <div>
        <span class="eyebrow">Ready when you are</span><h2>
          Answer the signal.
        </h2><p>
          Our Discord invitation will be connected here once the guild's
          permanent invite is ready.
        </p>
      </div><button class="button primary" disabled
        >Discord link coming soon</button
      >
    </div>
  </section>
</BaseLayout>

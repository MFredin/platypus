---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { newsItems } from '../../data/news';
---

<BaseLayout
  title="News"
  description="Announcements, field reports, and recruitment updates from Daybreak."
>
  <section class="page-hero news-hero">
    <span class="eyebrow">Guild transmissions</span><h1>
      From the<br /><em>horizon.</em>
    </h1><p>
      Official announcements, fleet reports, and signals from across the
      Daybreak network.
    </p>
  </section>
  <section class="section archive">
    <div class="archive-head">
      <span class="chapter">Latest signals</span><p>
        All transmissions / {String(newsItems.length).padStart(3, '0')}
      </p>
    </div><div class="news-grid archive-grid">
      {newsItems.map((item) => <NewsCard {...item} />)}
    </div>
  </section>
</BaseLayout>

---
import Logo from './Logo.astro';
import { sitePath } from '../utils/paths';
const path = Astro.url.pathname;
const home = sitePath('/');
const links = [
  { href: home, label: 'Home' },
  { href: sitePath('news'), label: 'News' },
  { href: sitePath('about'), label: 'About' },
  { href: sitePath('join'), label: 'Join' },
];
const active = (href: string) =>
  href === home ? path === home : path.startsWith(href);
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header" data-header>
  <nav class="nav-shell" aria-label="Primary navigation">
    <div class="nav-links nav-left">
      {
        links.slice(0, 2).map((link) => (
          <a
            href={link.href}
            aria-current={active(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <a class="brand" href={home} aria-label="Daybreak home">
      <Logo compact />
      <span>DAYBREAK</span>
    </a>
    <div class="nav-links nav-right">
      {
        links.slice(2).map((link) => (
          <a
            class:list={{ join: link.label === 'Join' }}
            href={link.href}
            aria-current={active(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span><span></span><b class="sr-only">Toggle menu</b>
    </button>
    <a class="mobile-join" href={sitePath('join')}>Join</a>
  </nav>
  <div class="mobile-menu" id="mobile-menu" hidden>
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={active(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <p>Together at dawn.<br />Limitless beyond.</p>
  </div>
</header>
<script>
  const header = document.querySelector('[data-header]');
  const button = header?.querySelector('.menu-toggle');
  const buttonLabel = button?.querySelector('.sr-only');
  const menu = header?.querySelector('.mobile-menu');
  const syncHeader = () =>
    header?.classList.toggle('scrolled', window.scrollY > 24);
  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    if (menu instanceof HTMLElement) menu.hidden = !open;
    if (buttonLabel)
      buttonLabel.textContent = open ? 'Close menu' : 'Open menu';
    document.body.classList.toggle('menu-open', open);
  });
</script>

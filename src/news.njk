---
layout: layouts/base.njk
title: News
description: Guild news and announcements from Daybreak.
---
<section>
  <div class="container">
    <div class="section__head">
      <div class="eyebrow">Dispatches</div>
      <h1>News</h1>
    </div>
    <div class="divider-wrap">{% sunburstDivider 200 %}</div>

    <div class="news-list">
      {% for post in collections.news %}
      <article class="news-item">
        <span class="news-item__date">{{ post.data.date | readableDate }}</span>
        <h2 class="news-item__title"><a href="{{ post.url | url }}">{{ post.data.title }}</a></h2>
        {% if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
        <a href="{{ post.url | url }}">Read more &rarr;</a>
      </article>
      {% else %}
      <p>No news yet — check back soon.</p>
      {% endfor %}
    </div>
  </div>
</section>

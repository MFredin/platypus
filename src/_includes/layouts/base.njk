<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }} — {{ site.game }}{% endif %}</title>
  <meta name="description" content="{{ description or site.subline }}" />
  <link rel="icon" href="data:," />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}" />
</head>
<body>
  <header class="site-header">
    <div class="site-header__bar">
      <a class="site-header__brand" href="{{ '/' | url }}">
        {% ringBadge 6, 32 %}
        <span class="site-header__brand-name">{{ site.title }}</span>
      </a>
      <nav aria-label="Primary">
        <ul class="site-nav">
          {% for item in site.nav %}
          <li><a href="{{ item.url | url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
          <li><a class="btn btn--ghost" href="{{ site.discordInvite }}" rel="noopener" target="_blank">Join Discord</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="eyebrow">{{ site.game }}</div>
      <p>{{ site.subline }}</p>
      <ul class="site-footer__links">
        <li><a href="{{ site.discordInvite }}" rel="noopener" target="_blank">Discord</a></li>
        <li><a href="{{ '/roster/' | url }}">Roster</a></li>
        <li><a href="{{ '/news/' | url }}">News</a></li>
      </ul>
    </div>
  </footer>
</body>
</html>

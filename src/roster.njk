---
layout: layouts/base.njk
title: Roster
description: Meet the members of Daybreak.
---
<section>
  <div class="container">
    <div class="section__head">
      <div class="eyebrow">The Guild</div>
      <h1>Roster</h1>
    </div>
    <div class="divider-wrap">{% sunburstDivider 200 %}</div>

    <p class="roster-note">
      This roster is placeholder data for launch — edit <code>src/_data/roster.json</code>
      to add real members. Each entry takes a name, rank, tier (0 Recruit → 6 Founder,
      controls badge ornamentation), and an optional specialization.
    </p>

    <div class="roster-grid">
      {% for member in roster | sort(true, false, "tier") %}
      <div class="roster-card">
        <div class="roster-card__badge">{% ringBadge member.tier, 48 %}</div>
        <div>
          <p class="roster-card__name">{{ member.name }}</p>
          <p class="roster-card__rank">{{ member.rank }}</p>
          {% if member.specialization %}
          <p class="roster-card__class">{{ member.specialization }}</p>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

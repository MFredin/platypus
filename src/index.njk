---
layout: layouts/base.njk
title: Home
description: "Daybreak — a guild in Foundation: Galactic Frontier. Join the Foundation."
---
<section class="hero">
  <div class="hero__inner">
    <div class="hero__emblem">{% emblem 220 %}</div>
    <h1>{{ site.title }}</h1>
    <p class="hero__tagline">{{ site.tagline }}</p>
    <p class="hero__subline">{{ site.subline }}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ site.discordInvite }}" rel="noopener" target="_blank">Join Daybreak on Discord</a>
      <a class="btn btn--ghost" href="{{ '/roster/' | url }}">Meet the Guild</a>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="section__head">
      <div class="eyebrow">Who We Are</div>
